<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net6.0</TargetFramework>
    <UseAppHost>false</UseAppHost><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic><UseSharedCompilation>false</UseSharedCompilation>
    <DebugType>none</DebugType><DebugSymbols>false</DebugSymbols>
    <PathMap>$(MSBuildProjectDirectory)=/_/tv-capture/</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\xattr-backup\XattrBackup.csproj" />
  </ItemGroup>
</Project>
