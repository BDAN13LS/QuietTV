<Project Sdk="Microsoft.NET.Sdk">
  <!-- Read-only TV inventory collector. net6.0, pure BCL, framework-dependent dll, no apphost,
       no native code, no package references; reproducibility settings match launcher/host. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>QuietTVInspect</AssemblyName>
    <RootNamespace>QuietTVInspect</RootNamespace>
    <Platforms>AnyCPU</Platforms>
    <UseAppHost>false</UseAppHost>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSharedCompilation>false</UseSharedCompilation>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildProjectDirectory)=/_/tv-inspect/</PathMap>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Inspector.cs" />
    <Compile Include="SelfTests.cs" />
  </ItemGroup>
</Project>
